+
+// These are in/out words. Validate before logging or any typed dereference.
+// Four-byte alignment plus distinct physical offsets excludes partial/aliased overlap.
+bool IsValidMemoryOutputPair(MappedU32 base_ptr, MappedU32 size_ptr) {
+  const u32 base = base_ptr.GetGuestAddress();
+  const u32 size = size_ptr.GetGuestAddress();
+  if (!base || !size || (base & 3u) || (size & 3u) ||
+      base > 0xfffffffcu || size > 0xfffffffcu || base == size) {
+    return false;
+  }
+  auto& state = kernel::GetCurrentState();
+  auto& memory = state.GetGuestMemory();
+  auto* space = state.GetAddressSpace();
+  const u32 physical_base = space->GetPhysicalAddress(base);
+  const u32 physical_size = space->GetPhysicalAddress(size);
+  if (physical_base != UINT32_MAX && physical_base == physical_size) {
+    return false;
+  }
+  const auto valid_word = [&](u32 address, u32 physical) {
+    if (memory.GetReadOnlySpan(address, 4) && memory.GetWritableSpan(address, 4)) {
+      return true;
+    }
+    // An unallocated physical view may alias committed backing in another view.
+    // Never override an explicit reservation/protection in the requested view.
+    if (physical == UINT32_MAX) {
+      return false;
+    }
+    kernel::HeapAllocation view{};
+    auto* heap = space->LookupHeap(address);
+    if (!heap || !heap->QueryRegionInfo(address, &view) || view.state != 0) {
+      return false;
+    }
+    u32 protect = 0;
+    constexpr u32 required = kernel::kMemoryProtectRead | kernel::kMemoryProtectWrite;
+    if (!space->GetPhysicalHeap()->QueryProtect(physical, &protect) ||
+        (protect & required) != required) {
+      return false;
+    }
+    size_t length = 0;
+    auto access = rex::memory::PageAccess::kNoAccess;
+    return rex::memory::QueryProtect(space->TranslateVirtual(address), length, access) &&
+           length >= 4 && (access == rex::memory::PageAccess::kReadWrite ||
+                           access == rex::memory::PageAccess::kExecuteReadWrite);
+  };
+  return valid_word(base, physical_base) && valid_word(size, physical_size);
 }
 
